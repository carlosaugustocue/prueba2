APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# En entorno local la app usa el host de la petición (no hace falta poner una IP fija).
# En producción define aquí la URL pública (ej. https://tudominio.com).
APP_TIMEZONE=America/Bogota

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp provider: meta | twilio
WHATSAPP_PROVIDER=meta

# WhatsApp Cloud API (Meta)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_LANGUAGE=es_CO
WHATSAPP_TEMPLATE_CONFIRMATION=serviconli_cita_confirmada
WHATSAPP_TEMPLATE_REMINDER_MORNING=serviconli_recordatorio_cita_manana

# Twilio WhatsApp (si WHATSAPP_PROVIDER=twilio)
# Formato from: whatsapp:+14155238886 (sandbox) o tu número habilitado
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Appointment notifications
CONFIRMATION_AUTO_SEND=true
REMINDER_SEND_TIME=08:00
REMINDER_TIMEZONE=America/Bogota

VITE_APP_NAME="${APP_NAME}"
# Solo si usas `npm run dev` y abres la app desde otro equipo: pon la IP de esta máquina.
# Opcional; en producción usa `npm run build` y no hace falta.
# VITE_HMR_HOST=
